{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "BRAND_KEY",
        "APP_ENV",
        "NEXT_PUBLIC_SITE_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_PUBLIC_BASE_URL",
        "S3_LEGACY_PUBLIC_HOSTS"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "SESSION_SECRET",
        "OTP_PEPPER"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
