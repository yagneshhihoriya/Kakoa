# ─── KAKOA environment variables (see packages/config/src/env.ts) ───
# Copy to .env.local and fill in. Required vars are marked; the rest are
# optional in Phase 0/1 (integrations run against in-repo mocks).

# ── Core (REQUIRED) ─────────────────────────────────────────────────
# Postgres connection string (Supabase pooled URL in hosted envs)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kakoa
# Absolute public origin of the storefront; feeds canonicals/sitemap (REQUIRED)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret pepper mixed into OTP hashes; min 32 chars (REQUIRED)
OTP_PEPPER=change-me-to-a-random-string-of-32-plus-chars
# Secret for signing session cookies/tokens; min 32 chars (REQUIRED)
SESSION_SECRET=change-me-to-a-random-string-of-32-plus-chars
# Deployment environment: local | preview | staging | production (REQUIRED)
APP_ENV=local

# ── Razorpay (optional until payments go live) ──────────────────────
# Razorpay API key id (rzp_test_... in staging)
RAZORPAY_KEY_ID=
# Razorpay API key secret
RAZORPAY_KEY_SECRET=
# Secret configured on the Razorpay webhook endpoint (HMAC of raw body)
RAZORPAY_WEBHOOK_SECRET=

# ── Shiprocket (optional until fulfilment goes live) ────────────────
# Shiprocket API user email (for token auth)
SHIPROCKET_EMAIL=
# Shiprocket API user password
SHIPROCKET_PASSWORD=
# Shared secret sent as x-api-key on Shiprocket webhooks
SHIPROCKET_WEBHOOK_TOKEN=

# ── Vercel Cron (optional; secures the scheduled shipment poller) ────
# Set in the Vercel project env; Vercel auto-attaches it as a Bearer token to
# /api/cron/poll-shipments. Locally, set it to test the cron route by hand.
CRON_SECRET=

# ── MSG91 SMS/OTP (optional; mocked locally) ────────────────────────
# MSG91 account auth key
MSG91_AUTH_KEY=
# MSG91 DLT-approved OTP template id
MSG91_OTP_TEMPLATE_ID=

# ── Resend email (optional; mocked locally) ─────────────────────────
# Resend API key
RESEND_API_KEY=
# From address for transactional email (SPF/DKIM/DMARC verified domain)
EMAIL_FROM=orders@kakoa.example

# ── Inngest (optional; local dev server needs no keys) ──────────────
# Inngest event key for sending events
INNGEST_EVENT_KEY=
# Inngest signing key for the serve endpoint
INNGEST_SIGNING_KEY=

# ── Observability (optional) ────────────────────────────────────────
# Sentry DSN for error reporting
SENTRY_DSN=

# ── Media storage / Cloudflare R2 (optional; local disk until set) ───
# Product + Media Library images. Leave the whole block commented out and
# uploads go to apps/web/public/uploads (dev). To use R2, uncomment ALL of
# S3_ENDPOINT/S3_REGION/S3_BUCKET/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY/
# S3_PUBLIC_BASE_URL and fill them in — an empty value is rejected by the env
# schema (fail-fast), so never leave one of these blank. Full setup, including
# how to get each value: docs/MEDIA-STORAGE-R2.md
# R2 S3-API endpoint (from the R2 dashboard / account id):
#S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2 requires "auto"
#S3_REGION=auto
# The R2 bucket name (created with `npx wrangler r2 bucket create <name>`)
#S3_BUCKET=<bucket-name>
# R2 API token (Object Read & Write, scoped to the bucket)
#S3_ACCESS_KEY_ID=<access-key-id>
#S3_SECRET_ACCESS_KEY=<secret-access-key>
# Public URL of the bucket (r2.dev subdomain or a connected custom domain).
# REQUIRED when S3_ENDPOINT is set — the API endpoint is not publicly readable.
#S3_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev
# Optional: comma-separated previous media hosts (e.g. the old AWS bucket host)
# that must keep rendering for rows uploaded before the switch. Never deleted.
#S3_LEGACY_PUBLIC_HOSTS=<old-bucket>.s3.<region>.amazonaws.com
